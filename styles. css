:root {
  --cream: #f5eee4;
  --paper: #fbf7f1;
  --terracotta: #a96048;
  --terra-light: #c98970;
  --brown: #3d2a25;
  --muted: #76635b;
  --line: rgba(61, 42, 37, 0.18);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--brown);
  font-family: "Manrope", sans-serif;
  font-weight: 300;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ШАПКА */

.nav {
  height: 86px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5vw;
  border-bottom: 1px solid var(--line);
  position: absolute;
  z-index: 10;
  width: 100%;
}

.brand,
.final-mark {
  font-family: "Cormorant Garamond", serif;
  font-size: 29px;
  font-weight: 600;
  letter-spacing: -1px;
}

.brand span,
.final-mark span {
  color: var(--terracotta);
}

.nav-link {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  border-bottom: 1px solid var(--brown);
  padding-bottom: 4px;
}

/* ПЕРВЫЙ ЭКРАН */

.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  padding: 140px 7vw 70px;
  align-items: center;
  position: relative;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 11px;
  font-weight: 500;
  margin: 0 0 28px;
}

h1,
h2 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 500;
  line-height: 0.83;
  letter-spacing: -0.045em;
}

h1 {
  font-size: clamp(82px, 11vw, 174px);
  margin: 0 0 34px;
}

h1 em,
h2 em {
  font-weight: 500;
  color: var(--terracotta);
}

h3,
p {
  margin-top: 0;
}

.lead {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(20px, 2vw, 28px);
  line-height: 1.28;
  max-width: 610px;
  margin-bottom: 38px;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 36px;
  background: var(--brown);
  color: var(--paper);
  padding: 17px 22px;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  transition: 0.25s;
}

.button:hover {
  transform: translateY(-2px);
  background: var(--terracotta);
}

/* РИСУНОК */

.hero-art {
  height: min(70vw, 690px);
  max-height: 690px;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  color: var(--brown);
}

.sun {
  position: absolute;
  width: 72%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--terracotta);
  top: 7%;
  right: 2%;
  opacity: 0.93;
}

.woman {
  position: relative;
  height: 94%;
  width: auto;
  z-index: 2;
}

.script-note {
  font-family: "Marck Script", cursive;
  font-size: 30px;
  position: absolute;
  right: 4%;
  bottom: 13%;
  transform: rotate(-7deg);
  z-index: 3;
}

/* ОБЩИЕ СЕКЦИИ */

.section {
  padding: 120px 8vw;
}

/* А ЧЕГО ХОЧУ Я */

.question {
  background: var(--paper);
}

.question-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8vw;
  align-items: start;
}

.question h2,
.section-head h2,
.inside h2,
.permission h2,
.final h2 {
  font-size: clamp(58px, 8vw, 120px);
  margin: 0;
}

.question-text {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(21px, 2vw, 29px);
  line-height: 1.4;
  padding-top: 10px;
}

.question-text p {
  margin-bottom: 24px;
}

.question-text strong {
  font-weight: 600;
  color: var(--terracotta);
}

/* НАПРАВЛЕНИЯ */

.directions {
  background: var(--cream);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 70px;
}

.section-head .eyebrow {
  align-self: flex-start;
}

.section-head h2 {
  text-align: right;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.card {
  min-height: 300px;
  padding: 38px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  position: relative;
  transition: 0.3s;
}

.card:hover {
  background: var(--paper);
}

.card span {
  font-size: 11px;
  letter-spacing: 0.16em;
  color: var(--terracotta);
}

.card h3 {
  font-family: "Cormorant Garamond", serif;
  font-size: 42px;
  font-weight: 500;
  margin: 62px 0 18px;
}

.card p {
  max-width: 510px;
  line-height: 1.65;
  color: var(--muted);
  font-size: 14px;
}

.card-wide {
  grid-column: 1 / -1;
  min-height: 250px;
}

.card-wide h3 {
  margin-top: 38px;
}

/* ЧТО ВНУТРИ */

.inside {
  background: var(--terracotta);
  color: var(--paper);
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 8vw;
}

.inside-title {
  position: sticky;
  top: 60px;
  align-self: start;
}

.inside-title .eyebrow {
  opacity: 0.8;
}

.inside-title h2 em {
  color: var(--paper);
  font-style: italic;
}

.inside-list {
  border-top: 1px solid rgba(255, 255, 255, 0.35);
}

.inside-item {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 18px;
  padding: 30px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.35);
}

.inside-item b {
  font-size: 11px;
  font-weight: 400;
  opacity: 0.65;
}

.inside-item h3 {
  font-family: "Cormorant Garamond", serif;
  font-size: 30px;
  font-weight: 500;
  margin-bottom: 8px;
}

.inside-item p {
  font-size: 14px;
  line-height: 1.65;
  max-width: 650px;
  margin: 0;
  opacity: 0.85;
}

/* МНЕ МОЖНО */

.permission {
  background: var(--paper);
  text-align: center;
}

.permission-inner {
  max-width: 1050px;
  margin: auto;
}

.permission h2 {
  margin-bottom: 60px;
}

.permissions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

.permissions span {
  border: 1px solid var(--line);
  padding: 13px 18px;
  border-radius: 40px;
  font-family: "Cormorant Garamond", serif;
  font-size: 20px;
  background: var(--cream);
}

/* ФИНАЛ */

.final {
  text-align: center;
  min-height: 720px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.final-mark {
  margin-bottom: 50px;
}

.final h2 {
  font-size: clamp(78px, 12vw, 160px);
  margin-bottom: 34px;
}

.final p {
  font-family: "Cormorant Garamond", serif;
  font-size: 24px;
  margin-bottom: 32px;
}

/* ПОДВАЛ */

footer {
  padding: 30px 5vw;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  letter-spacing: 0.08em;
}

/* АНИМАЦИЯ */

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: none;
}

/* МОБИЛЬНАЯ ВЕРСИЯ */

@media (max-width: 800px) {

  .nav {
    height: 70px;
    padding: 0 22px;
  }

  .brand {
    font-size: 24px;
  }

  .nav-link {
    font-size: 10px;
  }

  .hero {
    min-height: auto;
    grid-template-columns: 1fr;
    padding: 120px 22px 60px;
  }

  .hero-copy {
    z-index: 3;
  }

  .hero h1 {
    font-size: 26vw;
  }

  .lead br {
    display: none;
  }

  .hero-art {
    height: 105vw;
    margin-top: -10px;
  }

  .sun {
    width: 68%;
    right: 3%;
  }

  .script-note {
    font-size: 24px;
    right: 2%;
  }

  .section {
    padding: 82px 22px;
  }

  .question-grid,
  .inside {
    grid-template-columns: 1fr;
  }

  .question-grid {
    gap: 42px;
  }

  .question h2,
  .section-head h2,
  .inside h2,
  .permission h2 {
    font-size: 17vw;
  }

  .section-head {
    display: block;
    margin-bottom: 42px;
  }

  .section-head h2 {
    text-align: left;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .card-wide {
    grid-column: auto;
  }

  .card {
    min-height: 260px;
    padding: 28px;
  }

  .card h3 {
    margin-top: 45px;
    font-size: 37px;
  }

  .inside {
    gap: 60px;
  }

  .inside-title {
    position: static;
  }

  .inside-item {
    grid-template-columns: 34px 1fr;
  }

  .inside-item h3 {
    font-size: 27px;
  }

  .permission h2 {
    margin-bottom: 38px;
  }

  .permissions span {
    font-size: 18px;
  }

  .final {
    min-height: 600px;
  }

  .final h2 {
    font-size: 24vw;
  }

  .final p {
    font-size: 21px;
  }

  footer {
    gap: 18px;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
